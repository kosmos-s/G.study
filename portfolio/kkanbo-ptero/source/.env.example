# Discord Bot Token
DISCORD_TOKEN=

# 상태판을 올릴 Discord 텍스트 채널 ID
DISCORD_CHANNEL_ID=

# 선택 사항: 서버 열림/종료 알림을 다른 채널로 보내고 싶을 때만 입력
# 비워두면 DISCORD_CHANNEL_ID와 같은 채널에 알림을 보냅니다.
DISCORD_NOTIFICATION_CHANNEL_ID=

# Pterodactyl Panel 주소 (끝의 / 없이 권장)
PTERODACTYL_URL=https://panel.example.com

# Pterodactyl Client API Key (ptlc_...)
PTERODACTYL_API_KEY=

# Pterodactyl 상태 확인 주기 (초, 최소 30초)
UPDATE_INTERVAL_SECONDS=30

# 업타임 표시 때문에 현황판 자체를 다시 그리는 주기 (초)
# 상태가 바뀌면 이 주기와 상관없이 즉시 갱신됩니다.
BOARD_REFRESH_SECONDS=300

# Discord Embed 제목
PANEL_NAME=깐보's Pterodactyl

# 현황판에서 제외할 Pterodactyl 서버 이름 또는 identifier (쉼표 구분)
EXCLUDE_SERVERS=깐보's Ptero
